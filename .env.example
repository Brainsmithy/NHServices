# EmailJS (client-side contact form).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Supabase — project URL + service-role key (server-only; bypasses RLS).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (Sprint 1.11).
AUTH_SECRET=
AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL — used by sitemap.ts, robots.ts, and OG metadataBase (Sprint 1.14).
NEXT_PUBLIC_SITE_URL=https://nhservicesllc.com
