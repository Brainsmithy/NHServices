VITE_APP_API_KEY=
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_USER_ID=

# EmailJS (Next.js).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Drizzle / libSQL backing store.
# Local dev: file:./local.db (default). Supabase/Postgres swap planned for Vercel cutover.
DATABASE_URL=file:./local.db

# Auth (Sprint 1.11).
AUTH_SECRET=
AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL — used by sitemap.ts, robots.ts, and OG metadataBase (Sprint 1.14).
NEXT_PUBLIC_SITE_URL=https://nhservicesllc.com
